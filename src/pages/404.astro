---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/paths';
---
<Base title="Seite nicht gefunden" description="Diese Seite konnten wir nicht finden." noindex={true}>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">404</p>
      <h1>Diese Seite konnten wir nicht finden.</h1>
      <div class="hero-actions">
        <a class="button" href={withBase('/')}>Zur Startseite</a>
        <a class="button ghost" href={withBase('/videos/')}>Videos ansehen</a>
      </div>
    </header>
  </div>
</Base>
