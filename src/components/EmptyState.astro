---
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  actionHref?: string;
  action?: string;
}
const { title, actionHref, action } = Astro.props;
---
<div class="empty">
  <p>{title}</p>
  {actionHref && action && <p><a class="link-arrow" href={withBase(actionHref)}>{action}</a></p>}
</div>
