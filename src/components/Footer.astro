---
import { footerDiscover, footerLegal, footerProject } from '../config/navigation';
import { connectedSocials } from '../config/social';
import { publisherLines, site } from '../config/site';
import { currentYear } from '../lib/format';
import { withBase } from '../lib/paths';

const watermark = withBase('/brand/watermark.svg');
const creditLogo = withBase('/brand/cyberdesigner.png');
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h2>Politik mit Kopf</h2>
        <p class="legal-note">{publisherLines.join(', ')}</p>
      </div>
      <div>
        <h2>Entdecken</h2>
        <ul>
          {footerDiscover.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Folgen</h2>
        <ul>
          {connectedSocials.map((item) => (
            <li><a href={item.href} rel="noopener noreferrer">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Projekt</h2>
        <ul>
          {footerProject.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          {footerLegal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
    </div>
    <p class="footer-mark" aria-hidden="true"><img src={watermark} alt="" width="980" height="140" decoding="async" loading="lazy" /></p>
    <p class="legal-note">© {currentYear()} {site.name}</p>
    <div class="cdcredit">
      <a class="cdlogo" href="https://cyberdesigner.de" target="_blank" rel="noopener" aria-label="cyberdesigner.de" style={`--cd-logo:url("${creditLogo}")`}><img src={creditLogo} alt="CyberDesigner.de" width="150" height="62" loading="lazy"></a>
      <a class="cdt" href="https://cyberdesigner.de" target="_blank" rel="noopener">Diese Website ist SEO- und GEO-optimiert und bedarf keinerlei Anfragen.</a>
    </div>
  </div>
</footer>
