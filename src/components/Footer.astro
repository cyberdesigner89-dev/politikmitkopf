---
import { footerDiscover, footerLegal, footerProject } from '../config/navigation';
import { connectedSocials } from '../config/social';
import { publisherLines, site } from '../config/site';
import { currentYear } from '../lib/format';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h2>Politik mit Kopf</h2>
        <p class="legal-note">{publisherLines.join(', ')}</p>
      </div>
      <div>
        <h2>Entdecken</h2>
        <ul>
          {footerDiscover.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Folgen</h2>
        <ul>
          {connectedSocials.map((item) => (
            <li><a href={item.href} rel="noopener noreferrer">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Projekt</h2>
        <ul>
          {footerProject.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          {footerLegal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
    </div>
    <p class="footer-mark" aria-hidden="true"><img src="/brand/watermark.svg" alt="" width="980" height="140" decoding="async" loading="lazy" /></p>
    <p class="legal-note">© {currentYear()} {site.name}</p>
    <div class="footer-credit">
      <a class="footer-credit-logo" href="https://cyberdesigner.de" target="_blank" rel="noopener noreferrer">
        <picture>
          <source type="image/webp" srcset="/images/cyberdesigner-logo.webp" />
          <img src="/images/cyberdesigner-logo.png" alt="cyberdesigner.de" width="300" height="124" decoding="async" loading="lazy" />
        </picture>
      </a>
      <a class="footer-credit-text" href="https://cyberdesigner.de" target="_blank" rel="noopener noreferrer">Diese Seite wurde entwickelt von cyberdesigner.de</a>
    </div>
  </div>
</footer>
